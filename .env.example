# Claimr Environment Variables
# Copy this file to '.env' and fill in your values.
# Expo automatically loads environment variables prefixed with EXPO_PUBLIC_ into the app.

# Optional: Discord webhook URL for receiving in-app feedback submissions directly
EXPO_PUBLIC_DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# Optional: Override default VAPID public key for Web Push notifications
EXPO_PUBLIC_VAPID_PUBLIC_KEY=
